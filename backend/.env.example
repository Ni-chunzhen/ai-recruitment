APP_NAME=ai-recruitment-api
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://recruit:replace-with-local-password@127.0.0.1:5432/recruit
REDIS_URL=redis://127.0.0.1:6379/0
# 默认复用 REDIS_URL；仅在需要独立 broker 时覆盖
CELERY_BROKER_URL=
# Sensitive AI queue (INTERVIEW_QUESTION_GENERATE). Default when empty: ai_sensitive.
# Same value must be used by Celery task_routes and worker -Q; restart API + all
# Celery workers after changing CELERY_SENSITIVE_QUEUE_NAME (重启后生效).
CELERY_SENSITIVE_QUEUE_NAME=
# Offer console mail queue. Default when empty: mail_outbound.
# Must match worker -Q mail_outbound; never reuse celery or ai_sensitive.
CELERY_MAIL_QUEUE_NAME=

JWT_SECRET=replace-with-local-jwt-secret-at-least-32-chars

# Fernet key for field encryption. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Missing/invalid key must fail closed; never reuse JWT_SECRET.
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI 异步任务（阶段 4 Phase C）
# mock：本地不依赖 Dify；dify：走真实工作流
AI_PROVIDER=mock
DIFY_API_BASE_URL=
DIFY_API_KEY=
# Dify 按「应用」鉴权：两个工作流通常需要两把 API Key（不能只靠 workflow_id 切换）
DIFY_JD_PARSE_API_KEY=
DIFY_SCORE_DIMENSION_API_KEY=
DIFY_JD_PARSE_WORKFLOW_ID=
DIFY_SCORE_DIMENSION_WORKFLOW_ID=
# 工作流入参/出参已在 app/services/ai_providers/dify.py 适配：
# JD_PARSE(=JD结构化.yml): 使用 DIFY_JD_PARSE_API_KEY；raw_jd_text→hr_manual_override；输出 result.structured_jd
#   成功后自动串联「能力维度生成」，result 附带 dimensions
# SCORE(=能力维度生成.yml): structured_jd JSON；输出 final_dimensions.dimensions
#   维度含 score_anchors{"1".."5"} → 内部 anchors[5]
# 不再使用「岗位解析.yml」
# 面试题纲 live（默认关闭）。Key 与 Workflow ID 必须成对；禁止复用 DIFY_API_KEY。
# 仅 ENVIRONMENT=development 且本开关为 true 时才允许 HTTP。
DIFY_INTERVIEW_QUESTION_LIVE_ENABLED=false
DIFY_INTERVIEW_QUESTION_GENERATE_API_KEY=
DIFY_INTERVIEW_QUESTION_GENERATE_WORKFLOW_ID=
AI_TASK_TIMEOUT_SECONDS=120
AI_RAW_PAYLOAD_RETENTION_DAYS=90
